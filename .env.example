# =========================================================
# CONFIGURACIÓN DE ENTORNO — LEDGERP2P VENEZUELA (SENIAT 16%)
# =========================================================

# 1. SUPABASE (PostgreSQL + Prisma ORM)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.supabase.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. BETTER AUTH (Autenticación + 2FA TOTP + Sesiones HttpOnly)
BETTER_AUTH_SECRET="f9a8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8"
BETTER_AUTH_URL="http://localhost:3000"

# 3. BÓVEDA CRIPTOGRÁFICA AES-256-GCM (32 bytes = 64 caracteres hex)
# Esta llave cifra tu API Secret de Binance antes de guardarlo en Supabase
MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 4. BINANCE SAPI C2C (Opcional en .env o configurable desde la Bóveda en la UI)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# 5. PARÁMETROS FISCALES VENEZUELA
SENIAT_TAX_RATE="0.16"
TIMEZONE="America/Caracas"
